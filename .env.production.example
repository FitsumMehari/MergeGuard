# Copy to .env.production and replace every CHANGE_ME value.
NODE_ENV=production

# Docker Compose database settings
POSTGRES_USER=mergeguard
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=mergeguard

# Bind app ports to localhost when Nginx runs on the same server.
API_BIND_HOST=127.0.0.1
API_PUBLIC_PORT=4000
WEB_BIND_HOST=127.0.0.1
WEB_PUBLIC_PORT=3000

# Public dashboard URL used in GitHub/GitLab result links.
WEB_URL=https://mergeguard.example.com

# Dashboard security
DASHBOARD_API_KEY=CHANGE_ME_LONG_RANDOM_API_KEY
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# GitHub App (leave blank if only using GitLab)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=

# GitLab (leave token blank if only using GitHub)
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=

# Jev / TypeSafe System One — the only AI provider
JEV_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=CHANGE_ME_JEV_API_KEY
JEV_MODEL=jev-latest
JEV_CONCURRENCY=6
JEV_REPORT_STRENGTH=0.62
JEV_FAIL_OPEN=false
REQUIRE_JEV=true
JEV_CONTEXT_CHARS=12000
JEV_TIMEOUT_MS=15000

# Worker / HTTP reliability
WORKER_CONCURRENCY=3
HTTP_TIMEOUT_MS=20000
HTTP_MAX_ATTEMPTS=3
WEBHOOK_BODY_LIMIT_BYTES=2000000

# Review behavior
INLINE_CONFIDENCE_THRESHOLD=0.86
REPORT_CONFIDENCE_THRESHOLD=0.72
MAX_CHANGED_FILES=120
MAX_PATCH_CHARS=120000
MAX_FILE_CONTENT_CHARS=48000
MAX_CANDIDATES=80
OFFLINE_REPORT_CONFIDENCE=0.58

# Repository intelligence / indexing
INDEX_MAX_FILES=800
INDEX_MAX_FILE_BYTES=120000
INDEX_MAX_FILE_CHARS=120000
INDEX_FETCH_CONCURRENCY=12
INDEX_MAX_TREE_PAGES=80
MAX_RELATED_FILES=50
