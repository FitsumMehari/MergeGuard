# Runtime
NODE_ENV=development
DATABASE_URL=postgresql://mergeguard:mergeguard@localhost:5432/mergeguard
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Dashboard security (required in production)
DASHBOARD_API_KEY=replace-with-a-long-random-secret
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-a-strong-password

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# GitLab
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=

# Jev / TypeSafe System One (the only AI provider)
JEV_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_CONCURRENCY=6
JEV_REPORT_STRENGTH=0.62
JEV_FAIL_OPEN=true
REQUIRE_JEV=false
JEV_CONTEXT_CHARS=12000
JEV_TIMEOUT_MS=15000

# Worker / HTTP reliability
WORKER_CONCURRENCY=3
HTTP_TIMEOUT_MS=20000
HTTP_MAX_ATTEMPTS=3
WEBHOOK_BODY_LIMIT_BYTES=2000000

# Review behavior
INLINE_CONFIDENCE_THRESHOLD=0.86
REPORT_CONFIDENCE_THRESHOLD=0.72
MAX_CHANGED_FILES=80
MAX_PATCH_CHARS=120000
MAX_FILE_CONTENT_CHARS=48000
MAX_CANDIDATES=80
OFFLINE_REPORT_CONFIDENCE=0.58

# Repository intelligence / indexing
INDEX_MAX_FILES=260
INDEX_MAX_FILE_BYTES=90000
INDEX_MAX_FILE_CHARS=90000
INDEX_FETCH_CONCURRENCY=10
INDEX_MAX_TREE_PAGES=8
MAX_RELATED_FILES=30
