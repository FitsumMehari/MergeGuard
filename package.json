{
  "name": "mergeguard",
  "version": "2.0.0",
  "description": "Local-first semantic code review gate for Git diffs",
  "type": "module",
  "bin": {
    "mergeguard": "./bin/mergeguard.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "docs",
    "examples",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "TEST_REPORT.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check bin/mergeguard.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check && npm test",
    "smoke": "node bin/mergeguard.js --help"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "git",
    "code-review",
    "static-analysis",
    "pre-push",
    "ci",
    "security",
    "semantic-analysis"
  ],
  "license": "Apache-2.0"
}
